# Copy this file to .env and fill in the values. Never commit the real .env.
# Only the settings the server really reads are listed here.

# "development" on your computer, "production" on Render
APP_ENV=development

# Database
MONGO_URL=
DB_NAME=

# Addresses of the website that may call this server, separated by commas
CORS_ORIGINS=

# 1 when the server runs behind a proxy (Render), so every visitor gets their own rate limit
TRUST_PROXY=

# Sign-in tokens: a long random text
JWT_SECRET=

# Gemini (the chat assistant)
GEMINI_API_KEY=
GEMINI_MODEL=

# Razorpay. While hotel bookings are demo bookings, use TEST keys only (they start with rzp_test_).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# The company hotel API (live hotel search, prices, photos and rooms), for example https://api-dev.destinoway.com
AKBAR_API_HOST=

# Leave empty while the company API's coupons are dummy data. Set to 1 when coupons are real.
HOTEL_COUPONS=

# Demo only: set to 1 to show the sign-in code on screen instead of sending it. Leave empty in production.
OTP_DEMO_MODE=
